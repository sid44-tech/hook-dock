# Copy to .env and fill in values. .env is gitignored - never commit it.

# Database. Leave HOOKDOCK_DB_URL empty to store everything in a local H2 file
# (./data/hookdock.mv.db) with no PostgreSQL needed. To use PostgreSQL, set it,
# for example to jdbc:postgresql://localhost:5432/hookdock. Docker Compose sets
# it for the app container itself, but its postgres service still needs the
# password below.
HOOKDOCK_DB_URL=
# HOOKDOCK_LOCAL_DB_PATH=./data/hookdock
HOOKDOCK_DB_USERNAME=
HOOKDOCK_DB_PASSWORD=

# First admin account - only used when no users exist yet
HOOKDOCK_ADMIN_USERNAME=
HOOKDOCK_ADMIN_PASSWORD=

# Allows forwarding/replay to localhost and private IPs, which is what you
# want for local development. Set to false anywhere HookDock is reachable by
# other people.
HOOKDOCK_ALLOW_PRIVATE_DESTINATIONS=true

# Optional
# HOOKDOCK_PORT=8080
# HOOKDOCK_MAX_BODY_SIZE=1MB
# HOOKDOCK_RATE_LIMIT_ENABLED=true
# HOOKDOCK_RATE_LIMIT_REQUESTS=20
# HOOKDOCK_RATE_LIMIT_PERIOD=1m
