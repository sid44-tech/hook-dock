# Copy to .env and fill in values. .env is gitignored - never commit it.
HOOKDOCK_DB_URL=jdbc:postgresql://localhost:5432/hookdock
HOOKDOCK_DB_USERNAME=hookdock
HOOKDOCK_DB_PASSWORD=change-me

# First admin account - only used when no users exist yet
HOOKDOCK_ADMIN_USERNAME=admin
HOOKDOCK_ADMIN_PASSWORD=change-me-too

# Local development only: allow forwarding/replay to localhost and private IPs.
# Leave false anywhere HookDock is reachable by other people.
HOOKDOCK_ALLOW_PRIVATE_DESTINATIONS=false

# Optional
# HOOKDOCK_PORT=8080
# HOOKDOCK_MAX_BODY_SIZE=1MB
