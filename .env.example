# Copy to .env and fill in values. .env is gitignored - never commit it.
HOOKDOCK_DB_URL=jdbc:postgresql://localhost:5432/hookdock
HOOKDOCK_DB_USERNAME=
HOOKDOCK_DB_PASSWORD=

# First admin account - only used when no users exist yet
HOOKDOCK_ADMIN_USERNAME=
HOOKDOCK_ADMIN_PASSWORD=

# Allows forwarding/replay to localhost and private IPs, which is what you
# want for local development. Set to false anywhere HookDock is reachable by
# other people.
HOOKDOCK_ALLOW_PRIVATE_DESTINATIONS=true

# Optional
# HOOKDOCK_PORT=8080
# HOOKDOCK_MAX_BODY_SIZE=1MB
